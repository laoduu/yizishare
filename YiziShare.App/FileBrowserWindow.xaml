<Window x:Class="YiziShare.App.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件浏览"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI, Arial">
    <Window.Resources>
        <Style x:Key="BrowserButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentGoldBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentGoldHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentGoldPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" Padding="16,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PathText" Text="" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Grid.Column="0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnRefresh" Content="🔄 刷新" Style="{StaticResource BrowserButton}" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnDownload" Content="⬇️ 下载" Style="{StaticResource BrowserButton}" Margin="8,0,0,0}" Click="BtnDownload_Click"/>
                    <Button x:Name="BtnUpload" Content="⬆️ 上传" Style="{StaticResource BrowserButton}" Margin="8,0,0,0}" Click="BtnUpload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ListView x:Name="FileList" Grid.Row="1" Margin="8" Background="Transparent" BorderThickness="0"
                  MouseDoubleClick="FileList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="300" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding ModifiedTime}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" Padding="16,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Border>
    </Grid>
</Window>
