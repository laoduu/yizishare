<Window x:Class="YiziShare.App.NicknameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改昵称"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI, Arial"
        FocusManager.FocusedElement="{Binding ElementName=NicknameInput}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="12"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（与主窗口头部同视觉语言） -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" CornerRadius="12,12,0,0"
                    BorderBrush="{DynamicResource HeaderSeparatorBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <TextBlock Text="修改昵称" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="✕" ToolTip="关闭"
                            Style="{StaticResource IconButton}" FontSize="12" Width="26" Height="26"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="20,16,20,20">
                <TextBlock x:Name="PromptText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Border Margin="0,10,0,0" CornerRadius="8"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <TextBox x:Name="NicknameInput" Height="34" FontSize="13"
                             VerticalContentAlignment="Center" Background="Transparent"
                             BorderThickness="0" Padding="10,0" MaxLength="20"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             TextChanged="NicknameInput_TextChanged"/>
                </Border>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="HintText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SemanticRedBrush}" Visibility="Collapsed"/>
                    <TextBlock Grid.Column="1" x:Name="CountText" FontSize="11"
                               Foreground="{DynamicResource TextFaintBrush}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="取消" Style="{StaticResource SecondaryGlassButton}"
                            MinWidth="76" Padding="12,7" Click="Close_Click"/>
                    <Button x:Name="OkButton" Content="确定" Style="{StaticResource GlassButton}"
                            Background="{DynamicResource AccentGoldBrush}"
                            MinWidth="76" Padding="12,7" Margin="8,0,0,0" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
