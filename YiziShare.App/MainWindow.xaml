<Window x:Class="YiziShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:YiziShare.App.ViewModels"
        xmlns:conv="clr-namespace:YiziShare.App.Converters"
        Title="YiziShare"
        Height="680" Width="320"
        MinHeight="560" MinWidth="300"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI, Arial"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        StateChanged="MainWindow_StateChanged"
        KeyDown="MainWindow_KeyDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 值转换器 -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:SelectionToBackgroundConverter x:Key="SelectionToBackgroundConverter"/>
        <conv:SelectionToBorderConverter x:Key="SelectionToBorderConverter"/>
        <conv:SelectionToThicknessConverter x:Key="SelectionToThicknessConverter"/>
        <conv:SelectionToAvatarConverter x:Key="SelectionToAvatarBrushConverter"/>
        <conv:SelectionToForegroundConverter x:Key="SelectionToTextConverter"/>
        <conv:FirstCharConverter x:Key="FirstCharConverter"/>

        <!-- 液态玻璃按钮 -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要玻璃按钮 -->
        <Style x:Key="SecondaryGlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBtnHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBtnPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏图标按钮 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.92"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 编辑图标按钮 -->
        <Style x:Key="EditIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态标签 -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- 设备项数据模板 -->
        <DataTemplate x:Key="DeviceItemTemplate">
            <Border Height="72"
                    Background="{Binding BackgroundBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="0,0,0,0"
                    CornerRadius="12"
                    Cursor="Hand"
                    Margin="12,4,12,4">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource {x:Type ContextMenu}}">
                        <MenuItem Header="📂 打开全部共享" IsEnabled="{Binding HasShares}" Click="OpenAllShares_Click"/>
                        <MenuItem Header="🔄 重新检测" Click="Recheck_Click" CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="✏️ 修改昵称" Click="EditNickname_Click" CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 头像 -->
                    <Grid Grid.Column="0" Width="48" Height="48">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{Binding AvatarBrush}"/>
                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstCharConverter}}"
                                   FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="14" Height="14" Fill="#4CAF50" Stroke="White" StrokeThickness="2"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                    </Grid>

                    <!-- 中间信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding TextBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Content="✏️" FontSize="12" Style="{StaticResource EditIconButton}"
                                    Width="24" Height="24"
                                    VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="修改昵称"
                                    Click="EditNickname_Click" CommandParameter="{Binding}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- 右侧警告或箭头 -->
                    <TextBlock Grid.Column="2" Text="▶" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                               VerticalAlignment="Center" Visibility="{Binding HasShares, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 共享卡片数据模板 -->
        <DataTemplate x:Key="ShareItemTemplate">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#0F000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="20"
                               Foreground="{DynamicResource AccentGoldBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShareName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="打开" Style="{StaticResource GlassButton}"
                            Background="{DynamicResource AccentGoldBrush}" Padding="12,5,12,5" FontSize="11"
                            VerticalAlignment="Center" Click="OpenShare_Click" CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 主容器 - 圆角 + 阴影 + 主题细边 -->
    <Border CornerRadius="16" Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Direction="270" Color="#20000000" Opacity="0.4"/>
        </Border.Effect>

        <!-- 外网格：头 + 内容 + 尾 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ========== 顶部标题栏（黑金） ========== -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" MouseLeftButtonDown="HeaderBg_MouseLeftButtonDown"
                    Background="{DynamicResource HeaderBgBrush}"
                    BorderBrush="{DynamicResource HeaderSeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- 高光层 -->
                    <Border CornerRadius="16,16,0,0" Height="24" VerticalAlignment="Top" IsHitTestVisible="False"
                            Background="{StaticResource BgHeaderHighlight}"/>
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#1C1913"
                                    BorderBrush="{StaticResource AccentGoldHoverBrush}" BorderThickness="1"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                <Image Source="/Assets/logo.png" Width="24" Height="24"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Clip>
                                        <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <TextBlock Text="YiziShare" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnTogglePanel" Content="◀" ToolTip="收起详情面板"
                                    Style="{StaticResource IconButton}" Visibility="Collapsed"
                                    Margin="0,0,2,0" Click="BtnTogglePanel_Click"/>
                            <Button x:Name="BtnScan" Content="🔄" ToolTip="重新扫描"
                                    Style="{StaticResource IconButton}" Click="BtnScan_Click"/>
                            <Button x:Name="BtnSettings" Content="⚙️" ToolTip="设置"
                                    Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="BtnSettings_Click"/>
                            <Button x:Name="BtnThemeToggle" Content="🌙" ToolTip="切换深色/浅色主题"
                                    Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="BtnThemeToggle_Click"/>
                            <Button Content="─" ToolTip="最小化" FontSize="14"
                                    Style="{StaticResource IconButton}" Margin="2,0" Click="BtnMinimize_Click"/>
                            <Button Content="✕" ToolTip="关闭到托盘" FontSize="13"
                                    Style="{StaticResource IconButton}" Margin="2,0" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========== 内容区域 ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="260"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：设备列表 -->
                <Grid Grid.Column="0" Background="{DynamicResource PanelBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" Padding="10,7" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Border CornerRadius="15" Background="{DynamicResource SearchPillBrush}" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         VerticalContentAlignment="Center" FontSize="12" Padding="7,0,0,0"/>
                            </Grid>
                        </Border>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,4">
                        <TextBlock Text="分组:" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbGroup" Width="80" FontSize="11" Padding="6,3" SelectedIndex="0"
                                  Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  SelectionChanged="CmbGroup_SelectionChanged">
                            <ComboBoxItem Content="无"/>
                            <ComboBoxItem Content="厂商"/>
                            <ComboBoxItem Content="状态"/>
                        </ComboBox>
                        <TextBlock Text="排序:" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <ComboBox x:Name="CmbSort" Width="80" FontSize="11" Padding="6,3" SelectedIndex="0"
                                  Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  SelectionChanged="CmbSort_SelectionChanged">
                            <ComboBoxItem Content="IP"/>
                            <ComboBoxItem Content="名称"/>
                            <ComboBoxItem Content="厂商"/>
                        </ComboBox>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" x:Name="DeviceScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,4">
                        <ItemsControl x:Name="DeviceListPanel" ItemsSource="{Binding Devices}"
                                      ItemTemplate="{StaticResource DeviceItemTemplate}"
                                      PreviewMouseLeftButtonDown="DeviceListPanel_PreviewMouseLeftButtonDown">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 右侧：详情面板 -->
                <Grid Grid.Column="1" x:Name="RightPanel" Background="{DynamicResource PanelBgBrush}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" Padding="24,20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid x:Name="DeviceInfoPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource NavyPrimaryBrush}" Margin="0,0,14,0">
                                    <TextBlock x:Name="DeviceAvatarIcon" Text="💻" FontSize="22"
                                               Foreground="{DynamicResource TextOnDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DeviceTitle" Text="{Binding SelectedDevice.DisplayName, FallbackValue=''}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnEditNickname" Content="✏️"
                                                Style="{StaticResource EditIconButton}" VerticalAlignment="Center"
                                                Margin="6,0,0,0" Click="BtnEditNickname_Click" Opacity="1"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock x:Name="DeviceIp" Text="{Binding SelectedDevice.IpAddress, FallbackValue='', StringFormat='📌 {0}'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="DeviceMac" Text="{Binding SelectedDevice.MacAddress, FallbackValue='', StringFormat='🔗 {0}'}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DeviceLastSeen" Text="" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border x:Name="StatusBadge" Style="{StaticResource StatusBadge}" Background="{DynamicResource SemanticGreenBgBrush}">
                                            <TextBlock x:Name="StatusText" Text="" FontSize="10" Foreground="{DynamicResource SemanticGreenBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnBrowse" Content="📁 浏览"
                                            Style="{StaticResource GlassButton}" VerticalAlignment="Center"
                                            Padding="12,7" Click="BtnBrowse_Click" Visibility="Collapsed"
                                            Background="{StaticResource AccentGoldBrush}" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnOpenAll" Content="📂 全部打开"
                                            Style="{StaticResource GlassButton}" VerticalAlignment="Center"
                                            Padding="12,7" Click="BtnOpenAll_Click" Visibility="Collapsed"
                                            Background="{StaticResource AccentGoldBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20" Background="{DynamicResource PanelBgBrush}">
                        <ItemsControl x:Name="ShareContentPanel" ItemsSource="{Binding SelectedDevice.SharedFolders, FallbackValue={x:Null}}"
                                      ItemTemplate="{StaticResource ShareItemTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========== 底部状态栏 ========== -->
            <Border Grid.Row="2" CornerRadius="0,0,16,16" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="BottomStatus" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
