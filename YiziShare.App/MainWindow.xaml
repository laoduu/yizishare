<Window x:Class="YiziShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:YiziShare.App"
        xmlns:vm="clr-namespace:YiziShare.App.ViewModels"
        xmlns:conv="clr-namespace:YiziShare.App.Converters"
        Title="YiziShare"
        Height="680" Width="320" MaxWidth="480"
        MinHeight="560" MinWidth="300"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI, Arial"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        StateChanged="MainWindow_StateChanged"
        KeyDown="MainWindow_KeyDown">

    <!-- 无边框窗口的缩放与最大化几何支持：
         CaptionHeight 压到 1px 保留自定义拖动逻辑，缩放边框和最大化工作区由 Chrome 接管 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="1"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 值转换器 -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:SelectionToBackgroundConverter x:Key="SelectionToBackgroundConverter"/>
        <conv:SelectionToBorderConverter x:Key="SelectionToBorderConverter"/>
        <conv:SelectionToThicknessConverter x:Key="SelectionToThicknessConverter"/>
        <conv:SelectionToAvatarConverter x:Key="SelectionToAvatarBrushConverter"/>
        <conv:SelectionToForegroundConverter x:Key="SelectionToTextConverter"/>
        <conv:FirstCharConverter x:Key="FirstCharConverter"/>

        <!-- 编辑图标按钮 -->
        <Style x:Key="EditIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态标签 -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- 设备项数据模板 -->
        <DataTemplate x:Key="DeviceItemTemplate">
            <Border Height="72"
                    Background="{Binding BackgroundBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="0,0,0,0"
                    CornerRadius="12"
                    Cursor="Hand"
                    Margin="12,4,12,4"
                    AllowDrop="True"
                    DragOver="DeviceCard_DragOver"
                    DragLeave="DeviceCard_DragLeave"
                    Drop="DeviceCard_Drop">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource {x:Type ContextMenu}}">
                        <MenuItem Header="打开全部共享" Click="OpenAllShares_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE8B7;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="发起聊天" Click="StartChat_Click" CommandParameter="{Binding}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE8BD;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="重新检测" Click="Recheck_Click" CommandParameter="{Binding}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE72C;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="网络唤醒" Click="WakeDevice_Click" CommandParameter="{Binding}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE7E8;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="修改昵称" Click="EditNickname_Click" CommandParameter="{Binding}">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE70F;"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 头像（新消息到达时脉冲一次；右上角红色数字角标） -->
                    <Grid Grid.Column="0" Width="48" Height="48">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="AvatarScale" CenterX="24" CenterY="24"/>
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnreadPulse}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     From="1" To="1.14" Duration="0:0:0.12"
                                                                     AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{Binding AvatarBrush}"/>
                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstCharConverter}}"
                                   FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- 在线状态点：绿=YiziShare 在线可聊天，灰=仅设备在线，浅灰=设备离线 -->
                        <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="2"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                 ToolTip="{Binding ChatStatusTip}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#9AA0A6"/>
                                    <Style.Triggers>
                                        <!-- 顺序即优先级（后者覆盖）：离线 < 仅设备在线 < 可聊天 -->
                                        <DataTrigger Binding="{Binding IsReachable}" Value="False">
                                            <Setter Property="Fill" Value="#D8DCE0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChatOnline}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- 未读角标（QQ 红点，叠在头像右上角） -->
                        <Border CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-4,0" Background="#E53935"
                                BorderBrush="{DynamicResource PanelBgBrush}" BorderThickness="1.5"
                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding UnreadBadgeText}" FontSize="10" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- 中间信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 超长主机名/昵称截断显示，完整名放 tooltip，防止把右侧图标挤出窗口 -->
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding TextBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"
                                       VerticalAlignment="Center"/>
                            <!-- 收藏与改昵称：hover 卡片时渐显，避免常驻图标挤占行宽 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="{Binding FavoriteIcon}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                        Foreground="{Binding FavoriteBrush}"
                                        Opacity="1" Padding="2" Style="{StaticResource EditIconButton}"
                                        ToolTip="收藏/取消收藏"
                                        Click="ToggleFavorite_Click" CommandParameter="{Binding}"/>
                                <Button FontSize="12" Style="{StaticResource EditIconButton}" FontFamily="Segoe MDL2 Assets"
                                        Width="24" Height="24" Opacity="1" Margin="4,0,0,0" ToolTip="修改昵称"
                                        Content="&#xE70F;"
                                        Click="EditNickname_Click" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- 右侧展开/收起箭头（展开时反向，点击可收起详情面板） -->
                    <Button Grid.Column="2" Content="{Binding PanelArrowIcon}" FontSize="11" Style="{StaticResource EditIconButton}"
                            Width="22" Height="22" Opacity="1"
                            VerticalAlignment="Center" ToolTip="{Binding PanelArrowTip}"
                            Click="PanelArrow_Click" CommandParameter="{Binding}"
                            Visibility="{Binding HasShares, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 共享卡片数据模板：平底 + 细描边 + hover 反馈（阴影在圆角卡片上会发虚成灰雾） -->
        <DataTemplate x:Key="ShareItemTemplate">
            <Border x:Name="ShareCard"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 金色文件夹矢量（与内置文件浏览统一） -->
                    <ContentControl Grid.Column="0" ContentTemplate="{StaticResource FolderIconTemplate}"
                                    Width="34" Height="29" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShareName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="打开" Style="{StaticResource GlassButton}"
                            Background="{DynamicResource AccentGoldBrush}" Padding="12,5,12,5" FontSize="11"
                            VerticalAlignment="Center" Click="OpenShare_Click" CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 聊天气泡项：单个气泡按 IsMine 切换左右与配色（不要渲染两个气泡，否则每条消息会出现两次） -->
        <DataTemplate x:Key="ChatMessageTemplate">
            <StackPanel Margin="16,0,16,0">
                <!-- 时间分隔线 -->
                <TextBlock Text="{Binding TimeDividerText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,8"
                           Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <StackPanel MaxWidth="300">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="0,4,32,4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="32,4,0,4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border CornerRadius="12,12,12,4" Padding="10,7"
                            ContextMenuOpening="Bubble_ContextMenuOpening">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ChatBubblePeerBgBrush}"/>
                                <Setter Property="CornerRadius" Value="12,12,12,4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ChatBubbleOwnBgBrush}"/>
                                        <Setter Property="CornerRadius" Value="12,12,4,12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MenuCopyText" Header="复制文本" Click="BubbleCopyText_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE8C8;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuCopyImage" Header="复制图片" Click="BubbleCopyImage_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE91B;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuOpenFile" Header="打开文件" InputGestureText="双击" Click="BubbleOpenFile_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE8E5;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuSaveAs" Header="另存为..." Click="BubbleSaveAs_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE792;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuOpenFolder" Header="打开所在文件夹" Click="BubbleOpenFolder_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE838;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator x:Name="MenuTransferSeparator"/>
                                <MenuItem x:Name="MenuAcceptFile" Header="接收文件" Click="BubbleAcceptFile_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE8B0;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuRejectFile" Header="拒绝接收" Click="BubbleRejectFile_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE711;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuCancelTransfer" Header="取消传输" Click="BubbleCancelTransfer_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE74D;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <!-- 内容三分支：文本 / 图片 / 文件（三元素叠放 + Visibility，Style 驱动——禁写本地 Visibility） -->
                        <Grid>
                            <ContentControl Content="{Binding RichText}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <Image Source="{Binding AttachmentPath}" MaxWidth="220" MaxHeight="220"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Cursor="Hand" MouseLeftButtonDown="BubbleImage_Click"
                                   ToolTip="点击用系统看图器打开">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <StackPanel Orientation="Horizontal" MinWidth="210">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- 文件类型图标：Shell 优先（1:1 像素显示 32px 源，避免缩放发糊），回退矢量 -->
                                <Grid Width="34" Height="32" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Image Source="{Binding ShellIcon}" Width="32" Height="32">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasShellIcon}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <ContentControl ContentTemplate="{StaticResource FileIconTemplate}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasShellIcon}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" MouseLeftButtonDown="BubbleFile_DoubleClick">
                                    <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               MaxWidth="200" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding AttachmentPath}"/>
                                    <TextBlock Text="{Binding FileCardHint}" FontSize="10"
                                               Foreground="{DynamicResource TextFaintBrush}" Margin="0,3,0,0"/>
                                    <!-- 大文件传输进度：进度条 + 右侧取消按钮（收发双向，传输中直接可见） -->
                                    <!-- 注意：Visibility 只能由 Style 驱动，本地值会压死触发器（本项目第五次踩坑） -->
                                    <Grid MinWidth="190" Margin="0,5,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowTransferProgress}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Height="4" VerticalAlignment="Center" BorderThickness="0"
                                                     Foreground="{DynamicResource AccentGoldBrush}"
                                                     Background="{DynamicResource CardBorderBrush}"/>
                                        <Button Grid.Column="1" Width="20" Height="20" Margin="6,0,0,0"
                                                Style="{StaticResource EditIconButton}" FontFamily="Segoe MDL2 Assets"
                                                FontSize="10" Content="&#xE711;" VerticalAlignment="Center"
                                                ToolTip="取消传输" Click="BubbleCancelTransfer_Click"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                    <!-- 大文件待接收：用户确认（防传输轰炸/塞盘攻击），超时自动拒绝 -->
                                    <!-- 注意：Visibility 只能由 Style 驱动，本地值会压死触发器 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsFile}" Value="True"/>
                                                            <Condition Binding="{Binding AwaitingAcceptance}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="接收" Style="{StaticResource SettingsSecondaryButton}"
                                                Padding="14,5" Margin="0,0,8,0" Click="BubbleAcceptFile_Click"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="拒绝" Style="{StaticResource SettingsSecondaryButton}"
                                                Padding="14,5" Click="BubbleRejectFile_Click"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 投递状态；失败或积压未发时可点击重试 -->
                    <Button Content="{Binding StateText}" FontSize="9" Margin="0,3,0,0"
                            HorizontalAlignment="Left" Cursor="Hand" BorderThickness="0" Padding="0"
                            Background="Transparent"
                            Click="ChatRetry_Click" CommandParameter="{Binding}"
                            Visibility="{Binding ShowStateText, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EditIconButton}">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Read">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentGoldBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter Property="Foreground" Value="{DynamicResource SemanticRedBrush}"/>
                                        <Setter Property="ToolTip" Value="发送失败，点击重新发送"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Queued">
                                        <Setter Property="Foreground" Value="{DynamicResource SemanticOrangeBrush}"/>
                                        <Setter Property="ToolTip" Value="对方离线，消息待发送；点击可立即重试"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- 主容器 - 圆角 + 主题细边（不可加 DropShadowEffect：根 Border 贴满窗口，阴影只会在四个圆角缺口处露出灰雾） -->
    <Border x:Name="RootBorder" CornerRadius="16" Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1">

        <!-- 外网格：头 + 内容 + 尾 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ========== 顶部标题栏（黑金） ========== -->
            <Border x:Name="HeaderBorder" Grid.Row="0" CornerRadius="16,16,0,0" MouseLeftButtonDown="HeaderBg_MouseLeftButtonDown"
                    Background="{DynamicResource HeaderBgBrush}"
                    BorderBrush="{DynamicResource HeaderSeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- 高光层 -->
                    <Border x:Name="HeaderHighlight" CornerRadius="16,16,0,0" Height="24" VerticalAlignment="Top" IsHitTestVisible="False"
                            Background="{StaticResource BgHeaderHighlight}"/>
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 头部直接展示 logo：保留自然形状，不裁切、无底板 -->
                            <Image Source="/Assets/logo.png" Width="28" Height="28" Margin="0,0,8,0"
                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="YiziShare" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 统一 MDL2 矢量图标体系（Segoe MDL2 Assets），不再使用 emoji -->
                            <Button x:Name="BtnTogglePanel" Style="{StaticResource HeaderIconButton}" Visibility="Collapsed"
                                    Margin="0,0,2,0" Click="BtnTogglePanel_Click" ToolTip="收起详情面板">
                                <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE76B;"/>
                            </Button>
                            <Button x:Name="BtnScan" Style="{StaticResource HeaderIconButton}" Click="BtnScan_Click" ToolTip="重新扫描">
                                <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE72C;"/>
                            </Button>
                            <Button x:Name="BtnSettings" Style="{StaticResource HeaderIconButton}" Margin="2,0,0,0" Click="BtnSettings_Click" ToolTip="设置">
                                <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE713;"/>
                            </Button>
                            <Button x:Name="BtnThemeToggle" Style="{StaticResource HeaderIconButton}" Margin="2,0,0,0" Click="BtnThemeToggle_Click" ToolTip="切换深色/浅色主题">
                                <TextBlock Style="{StaticResource Mdl2Glyph}" x:Name="ThemeGlyph" Text="&#xE708;"/>
                            </Button>
                            <!-- 窗口按钮顺序遵循 Windows 惯例：最小化、最大化、关闭 -->
                            <Button Content="─" ToolTip="最小化" FontSize="12"
                                    Style="{StaticResource HeaderIconButton}" Margin="4,0,0,0" Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaximize" Content="▢" ToolTip="最大化"
                                    Style="{StaticResource HeaderIconButton}" Margin="2,0,0,0" Click="BtnMaximize_Click"/>
                            <Button Content="✕" ToolTip="关闭到托盘" FontSize="12"
                                    Style="{StaticResource HeaderIconButton}" Margin="2,0,0,0" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========== 内容区域 ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- 收起状态下列表铺满整窗（星号），展开后由代码切回固定 300 -->
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：设备列表 -->
                <Grid Grid.Column="0" Background="{DynamicResource PanelBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" Padding="10,7" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Border CornerRadius="15" Background="{DynamicResource SearchPillBrush}" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <Grid Grid.Column="1">
                                    <!-- 占位提示：无输入时显示，输入后隐藏 -->
                                    <TextBlock Text="搜索设备名称或 IP..." FontSize="12" Margin="7,0,0,0"
                                               Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             VerticalContentAlignment="Center" FontSize="12" Padding="7,0,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,4">
                        <TextBlock Text="筛选:" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbGroup" Width="80" FontSize="11" Padding="6,3" SelectedIndex="0"
                                  Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  SelectionChanged="CmbGroup_SelectionChanged">
                            <ComboBoxItem Content="所有"/>
                            <ComboBoxItem Content="收藏"/>
                        </ComboBox>
                        <TextBlock Text="排序:" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <ComboBox x:Name="CmbSort" Width="80" FontSize="11" Padding="6,3" SelectedIndex="0"
                                  Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  SelectionChanged="CmbSort_SelectionChanged">
                            <ComboBoxItem Content="IP"/>
                            <ComboBoxItem Content="名称"/>
                        </ComboBox>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" x:Name="DeviceScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,4">
                        <ItemsControl x:Name="DeviceListPanel" ItemsSource="{Binding Devices}"
                                      ItemTemplate="{StaticResource DeviceItemTemplate}"
                                      PreviewMouseLeftButtonDown="DeviceListPanel_PreviewMouseLeftButtonDown">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 右侧：详情面板 -->
                <Grid Grid.Column="1" x:Name="RightPanel" Background="{DynamicResource PanelBgBrush}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" Padding="24,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid x:Name="DeviceInfoPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26"
                                    Background="{DynamicResource AccentGoldBrush}" Margin="0,0,14,0">
                                <TextBlock x:Name="DeviceAvatarIcon" Text="💻" FontSize="24"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- 第一行：昵称 + 状态徽标（紧跟昵称）+ hover 才出现的操作图标 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DeviceTitle" Text="" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="StatusBadge" Style="{StaticResource StatusBadge}" Margin="8,0,0,0"
                                            Background="{DynamicResource SemanticGreenBgBrush}" VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusText" Text="" FontSize="10"
                                                   Foreground="{DynamicResource SemanticGreenBrush}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" x:Name="DeviceHoverActions">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button x:Name="BtnFavorite" Content="☆" FontFamily="Segoe MDL2 Assets" Style="{StaticResource EditIconButton}"
                                                FontSize="14" Padding="2" Opacity="1" Click="BtnFavorite_Click" ToolTip="收藏/取消收藏"/>
                                        <Button x:Name="BtnEditNickname" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource EditIconButton}"
                                                FontSize="12" Padding="2" Opacity="1" Margin="4,0,0,0" Click="BtnEditNickname_Click" ToolTip="修改昵称"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 第二行：IP · MAC · 共享数，一行说清 -->
                                <TextBlock x:Name="DeviceMeta" Text="" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>

                                <!-- 第三行：历史连接（有记录才显示） -->
                                <TextBlock x:Name="DeviceLastSeen" Text="" FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFaintBrush}"/>
                            </StackPanel>

                            <!-- 只有离线且有 MAC 的设备才出现唤醒入口 -->
                            <Button x:Name="BtnWake" Grid.Column="2"
                                    Style="{StaticResource SecondaryGlassButton}" VerticalAlignment="Center"
                                    Padding="12,7" Click="BtnWake_Click" Visibility="Collapsed" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE7E8;"/>
                                    <TextBlock Text=" 唤醒"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ========== 共享 / 聊天 标签条（与整块面板同底色，仅用分割线区分区域） ========== -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- QQ 形态：聊天在左且为默认，共享在右 -->
                            <Button Grid.Column="0" x:Name="BtnTabChat" Content="💬 聊天"
                                    Style="{StaticResource EditIconButton}" Opacity="1" FontSize="12" Cursor="Hand"
                                    HorizontalAlignment="Stretch" Click="TabChat_Click"/>
                            <Button Grid.Column="1" x:Name="BtnTabShare" Content="📁 共享"
                                    Style="{StaticResource EditIconButton}" Opacity="1" FontSize="12" Cursor="Hand"
                                    HorizontalAlignment="Stretch" Click="TabShare_Click"/>

                            <!-- 激活标签下的金色指示条（默认在聊天侧） -->
                            <Border x:Name="TabIndicator" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,0"
                                    Grid.Column="0"
                                    Background="{DynamicResource AccentGoldBrush}"
                                    HorizontalAlignment="Center" Width="60"/>

                            <!-- 未读数字只在各设备头像上显示（按会话隔离），tab 旁不放跨会话的总数 -->
                        </Grid>
                    </Border>

                    <!-- ========== 共享页（默认隐藏，聊天为默认页） ========== -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20" Background="{DynamicResource PanelBgBrush}"
                                  x:Name="SharePane" Visibility="Collapsed">
                        <ItemsControl x:Name="ShareContentPanel" ItemsSource="{Binding SelectedDevice.SharedFolders, FallbackValue={x:Null}}"
                                      ItemTemplate="{StaticResource ShareItemTemplate}"/>
                    </ScrollViewer>

                    <!-- ========== 共享文件夹内置浏览（点"打开"后替代共享列表显示） ========== -->
                    <Grid Grid.Row="2" x:Name="FilePane" Background="{DynamicResource PanelBgBrush}" Visibility="Collapsed">
                        <local:ShareBrowserView x:Name="ShareBrowser"/>
                    </Grid>

                    <!-- ========== 聊天页 ==========
                         聊天对象由设备列表的选中项决定：选中谁就跟谁聊天，不引入多目标会话侧栏 -->
                    <Grid Grid.Row="2" x:Name="ChatPane" Background="{DynamicResource PanelBgBrush}"
                          AllowDrop="True" PreviewDragOver="ChatPane_PreviewDragOver"
                          PreviewDrop="ChatPane_PreviewDrop" DragLeave="ChatPane_DragLeave">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                            <!-- 空态提示 -->
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        x:Name="ChatEmptyHint" Visibility="Visible">
                                <TextBlock Text="💬" FontSize="34" HorizontalAlignment="Center" Opacity="0.6"/>
                                <TextBlock Text="还没有选择聊天对象" FontSize="12" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="点击左侧设备即可开始聊天" FontSize="10" Margin="0,14,0,0"
                                           Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"/>
                                <Button Content="返回设备列表" Style="{StaticResource SecondaryGlassButton}"
                                        Margin="0,10,0,0" Padding="14,6" Cursor="Hand"
                                        HorizontalAlignment="Center" Click="BackToShare_Click"/>
                            </StackPanel>

                            <!-- 会话头 -->
                            <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                                    x:Name="ChatHeader" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 注意不能写本地 Fill：本地值优先级高于 Style 默认值，会覆盖离线灰色（曾经的"常绿"根因） -->
                                        <Ellipse Width="9" Height="9" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Chat.SelectedConversation.IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource ChatOnlineDotBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Chat.ActivePeerName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Chat.ActivePeerIp}" FontSize="10"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 消息列表 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ChatScrollViewer">
                                <ItemsControl ItemsSource="{Binding Chat.SelectedConversation.Messages}"
                                              ItemTemplate="{StaticResource ChatMessageTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 输入区：顶部为拖拽条（兼任分割线，避免线叠线） -->
                            <Border Grid.Row="2" Padding="12,0,12,10" Background="{DynamicResource PanelBgBrush}"
                                    x:Name="ChatInputArea" Visibility="Collapsed">
                                <StackPanel>
                                    <Thumb x:Name="InputResizeThumb" Height="7" Cursor="SizeNS" Margin="0,0,0,3"
                                           DragDelta="InputResizeThumb_DragDelta">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent" Padding="0,2">
                                                    <Border Height="3" CornerRadius="1.5"
                                                            Background="{DynamicResource CardBorderBrush}"
                                                            HorizontalAlignment="Stretch"
                                                            Opacity="0.6"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                    <!-- 微信式输入框：编辑区在框内，表情/文件靠左、发送靠右（底栏），默认约 5 行高 -->
                                    <Border x:Name="InputBorder" CornerRadius="10" Background="{DynamicResource InputBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid Margin="6,2,6,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- RichTextBox：表情以彩色图片内联（TextBox 无法内嵌图像） -->
                                            <RichTextBox x:Name="ChatInputBox" MinHeight="86" MaxHeight="280" FontSize="12"
                                                         Background="Transparent" BorderThickness="0" Padding="6,4"
                                                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                         PreviewKeyDown="ChatInput_PreviewKeyDown"
                                                         DataObject.Pasting="ChatInputBox_Pasting">
                                                <FlowDocument PagePadding="0">
                                                    <Paragraph/>
                                                </FlowDocument>
                                            </RichTextBox>

                                            <Grid Grid.Row="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- 表情：MDL2 字形按钮，面板内容为 Twemoji 彩色图片 -->
                                                    <Button x:Name="BtnEmoji" Style="{StaticResource EditIconButton}"
                                                            Width="28" Height="26" ToolTip="表情" Click="BtnEmoji_Click">
                                                        <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE76E;"/>
                                                    </Button>
                                                    <!-- 文件：文档页图标（微信语义），选择任意文件作为消息发送（图片直接显示） -->
                                                    <Button x:Name="BtnAttach" Style="{StaticResource EditIconButton}"
                                                            Width="28" Height="26" Margin="2,0,0,0" ToolTip="发送文件" Click="BtnAttach_Click">
                                                        <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE7C3;"/>
                                                    </Button>
                                                </StackPanel>
                                                <Button x:Name="BtnSend" Content="发送" HorizontalAlignment="Right"
                                                        Style="{StaticResource SecondaryGlassButton}"
                                                        Height="28" Padding="16,0" Cursor="Hand" Click="ChatSend_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="EmojiPopup" AllowsTransparency="True"
                                           PlacementTarget="{Binding ElementName=BtnEmoji}" Placement="Top"
                                           StaysOpen="False" PopupAnimation="Fade">
                                        <Border Background="{DynamicResource CardBgBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="8" MaxHeight="260" Width="380"
                                                Margin="0,0,0,6">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#33000000" Opacity="0.4"/>
                                            </Border.Effect>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="EmojiPanel">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemWidth="44"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="42" Height="40" Cursor="Hand"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Click="Emoji_Click" Tag="{Binding Emoji}"
                                                                    ToolTip="{Binding Emoji}">
                                                                <Image Source="{Binding Image}" Width="26" Height="26"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ========== 底部状态栏 ========== -->
            <Border Grid.Row="2" CornerRadius="0,0,16,16" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VersionText" Text="" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="BottomStatus" Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
