<Window x:Class="YiziShare.App.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接共享需要登录"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI, Arial"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentGoldBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentGoldHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentGoldPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBtnHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBtnPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="28,24,28,20">
        <TextBlock x:Name="TargetText" Text="" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="目标设备开启了密码保护共享，请输入有权限的账号。"
                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="{DynamicResource SemanticRedBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <TextBlock Text="用户名" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,4"/>
        <TextBox x:Name="UserNameBox" FontSize="13" Padding="10,8"
                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>

        <TextBlock Text="密码" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PasswordBox" FontSize="13" Padding="10,8"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>

        <CheckBox x:Name="RememberBox" Content="记住凭据（保存到 Windows 凭据管理器，下次自动连接）"
                  IsChecked="True" FontSize="11"
                  Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0"/>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnCancel" Content="取消" Grid.Column="0" HorizontalAlignment="Left"
                    Style="{StaticResource DialogSecondaryButton}" Padding="18,8" Click="BtnCancel_Click"/>
            <Button x:Name="BtnConnect" Content="🔗 连接" Grid.Column="1"
                    Style="{StaticResource DialogPrimaryButton}" Padding="22,8" Margin="12,0,0,0" Click="BtnConnect_Click"/>
        </Grid>
    </StackPanel>
</Window>
