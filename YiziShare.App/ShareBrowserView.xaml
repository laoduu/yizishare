<UserControl x:Class="YiziShare.App.ShareBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI, Arial"
             Background="{DynamicResource PanelBgBrush}"
             KeyDown="Browser_KeyDown">
    <UserControl.Resources>
        <!-- 幽灵工具按钮：透明底 hover 高亮，图标(MDL2)+可选文字；金色填充按钮只留给主操作 -->
        <Style x:Key="ToolbarGhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单图标（MDL2 小图标） -->
        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- 文件夹/文件矢量模板已提升到 ThemeColors（应用级），共享卡片列表与内置浏览共用 -->

        <!-- 名称单元格（列表模式）：Shell 类型图标优先，回退矢量（文件夹金色）。
             注意：可见性与模板只能由 Style 驱动，本地属性值会压住触发器（历史教训 ×3） -->
        <DataTemplate x:Key="NameCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Margin="0,2,10,2" Width="26" Height="26" VerticalAlignment="Center">
                    <Image Source="{Binding ShellIcon}" Width="26" Height="26">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasShellIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource FileIconTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasShellIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource FolderIconTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 图标模式项：大图标 + 名称居中两行（图标选择逻辑同上） -->
        <DataTemplate x:Key="IconItemTemplate">
            <Border Width="104" Margin="4,6" Background="Transparent" ToolTip="{Binding Name}">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="48" Height="44" HorizontalAlignment="Center" Margin="0,2,0,6">
                        <Image Source="{Binding ShellIcon}" Width="38" Height="38" VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasShellIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Viewbox 按高度 38 等比放大（文件夹为宽扁形，按宽缩放会矮一截） -->
                        <Viewbox Width="45" Height="38">
                            <ContentControl Width="30" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource FileIconTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasShellIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource FolderIconTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" MaxHeight="30"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 列头：暗色适配（透明底、细分割线、hover 高亮），不可拖动重排避免浮动白头 -->
        <Style x:Key="ColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,1"
                                Padding="10,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGoldSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行容器（列表模式）：暗色 hover/选中，覆盖系统默认的亮色高亮 -->
        <Style x:Key="DetailsItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="6,0">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGoldSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行容器（图标模式） -->
        <Style x:Key="IconItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="90"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGoldSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 两种模式的行容器：列表垂直排列，图标流式换行 -->
        <ItemsPanelTemplate x:Key="DetailsItemsPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="IconItemsPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- 详情视图（ViewBase 资源）：由 ApplyViewMode 按 need 赋给 FileList.View -->
        <GridView x:Key="DetailsView" AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
            <GridViewColumn Header="名称" Width="330" CellTemplate="{StaticResource NameCellTemplate}"/>
            <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
            <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding ModifiedTime}"/>
        </GridView>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" Padding="14,10"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBack" Style="{StaticResource ToolbarGhostButton}" Click="BtnBack_Click" ToolTip="返回共享列表">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE72B;"/>
                        <TextBlock Text=" 返回"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PathText" Text="" FontSize="12" Margin="12,0,8,0"
                           VerticalAlignment="Center" Grid.Column="1" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- 幽灵按钮体系：上级/刷新为纯图标，上传/资源管理器带文字 -->
                    <Button x:Name="BtnUp" Style="{StaticResource ToolbarGhostButton}" Click="BtnUp_Click" ToolTip="上级">
                        <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE74A;"/>
                    </Button>
                    <Button x:Name="BtnRefresh" Style="{StaticResource ToolbarGhostButton}" Margin="2,0,0,0" Click="BtnRefresh_Click" ToolTip="刷新">
                        <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE72C;"/>
                    </Button>
                    <Button x:Name="BtnUpload" Style="{StaticResource ToolbarGhostButton}" Margin="8,0,0,0" Click="BtnUpload_Click" ToolTip="上传文件到当前目录">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE898;"/>
                            <TextBlock Text=" 上传"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnOpenInExplorer" Style="{StaticResource ToolbarGhostButton}" Margin="2,0,0,0"
                            Click="BtnOpenInExplorer_Click" ToolTip="在 Windows 资源管理器中打开当前文件夹">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Mdl2Glyph}" Text="&#xE838;"/>
                            <TextBlock Text=" 资源管理器"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnViewMode" Style="{StaticResource ToolbarGhostButton}" Margin="2,0,0,0" Click="BtnViewMode_Click" ToolTip="切换 列表/图标 视图"/>
                </StackPanel>
            </Grid>
        </Border>

        <ListView x:Name="FileList" Grid.Row="1" Margin="6" Background="Transparent" BorderThickness="0"
                  MouseDoubleClick="FileList_MouseDoubleClick"
                  ContextMenuOpening="FileList_ContextMenuOpening"
                  AllowDrop="True" Drop="FileList_Drop" DragOver="FileList_DragOver" DragLeave="FileList_DragLeave"
                  PreviewMouseMove="FileList_PreviewMouseMove"
                  PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ContextMenu>
                <ContextMenu Style="{StaticResource {x:Type ContextMenu}}">
                    <MenuItem x:Name="MenuOpen" Header="打开" Click="MenuOpen_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8E5;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuDownload" Header="下载到本地..." Click="MenuDownload_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE896;"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MenuCopy" Header="复制" InputGestureText="Ctrl+C" Click="MenuCopy_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C8;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuCut" Header="剪切" InputGestureText="Ctrl+X" Click="MenuCut_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C6;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuPaste" Header="粘贴" InputGestureText="Ctrl+V" Click="MenuPaste_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE77F;"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MenuRename" Header="重命名" InputGestureText="F2" Click="MenuRename_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8AC;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuDelete" Header="删除" InputGestureText="Delete" Click="MenuDelete_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE74D;"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="刷新" Click="BtnRefresh_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE72C;"/></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <Border Grid.Row="2" Background="{DynamicResource PanelBgBrush}" Padding="14,7"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
