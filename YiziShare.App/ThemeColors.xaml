<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        品牌层（明暗主题共用）：黑金取色自 Assets/app.ico
        表面层（随主题切换）见 Surface.Light.xaml / Surface.Dark.xaml，由 ThemeManager 运行时替换
    -->

    <!-- ===== 渐变 ===== -->
    <LinearGradientBrush x:Key="BgHeaderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141414" Offset="0"/>
        <GradientStop Color="#1C1913" Offset="0.5"/>
        <GradientStop Color="#0D0D0D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BgHeaderHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26F0B429" Offset="0"/>
        <GradientStop Color="#00F0B429" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BgStatusGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1C1913" Offset="0"/>
        <GradientStop Color="#0D0D0D" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 品牌金（不随主题变）===== -->
    <Color x:Key="AccentGoldColor">#C8912A</Color>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#C8912A"/>
    <SolidColorBrush x:Key="AccentGoldHoverBrush" Color="#D9A441"/>
    <SolidColorBrush x:Key="AccentGoldPressedBrush" Color="#B07E22"/>
    <Color x:Key="AccentGoldBrightColor">#F0B429</Color>
    <SolidColorBrush x:Key="AccentGoldBrightBrush" Color="#F0B429"/>
    <SolidColorBrush x:Key="HeaderSeparatorBrush" Color="#66F0B429"/>

    <!-- ===== 深藏蓝（次强调，不随主题变）===== -->
    <Color x:Key="NavyPrimaryColor">#1B2A4A</Color>
    <SolidColorBrush x:Key="NavyPrimaryBrush" Color="#1B2A4A"/>
    <Color x:Key="NavyHoverColor">#2C4370</Color>
    <SolidColorBrush x:Key="NavyHoverBrush" Color="#2C4370"/>

    <!-- ===== 深色区文字（不随主题变）===== -->
    <Color x:Key="TextOnDarkColor">#F5E9CF</Color>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#F5E9CF"/>

    <!-- ===== 细滚动条（隐式全局样式：所有 ScrollBar 含日志框内嵌滚动条统一适配主题）===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumbBorder" Background="{DynamicResource ScrollThumbBrush}"
                                                    CornerRadius="3" Margin="1,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumbBorder" Background="{DynamicResource ScrollThumbBrush}"
                                                            CornerRadius="3" Margin="0,1"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
